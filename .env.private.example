# Local-devnet demo credentials only. Never reuse publicly documented keys on a live network.
DEVNET_PRIVATE_KEY=replace_with_a_funded_local_devnet_private_key
DEVNET_PROTOCOL_PK=replace_with_the_protocol_private_key
DEVNET_ASSERTER_PK=replace_with_the_asserter_private_key
DEVNET_DISPUTER_PK=replace_with_the_disputer_private_key
DEVNET_VOTER_1_PK=replace_with_the_first_voter_private_key
DEVNET_VOTER_2_PK=replace_with_the_second_voter_private_key
DEVNET_VOTER_3_PK=replace_with_the_third_voter_private_key

# Public Testnet deployer. This must control PROTOCOL in .env.testnet.
TESTNET_PRIVATE_KEY=replace_with_a_funded_testnet_private_key
